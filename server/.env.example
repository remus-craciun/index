# Copy to .env and fill in. On startup the server loads .env from its working
# directory (server/); variables already set in the environment take priority.
# On Coolify, set these in the application's Environment Variables instead.

# Required. At least 32 bytes. Generate with: openssl rand -hex 32
JWT_SECRET=

# Optional. Without it, the AI endpoints return 503 ai_disabled.
GEMINI_API_KEY=
# Any Gemini model that supports structured output.
GEMINI_MODEL=gemini-flash-latest

# SQLite file. On Coolify, keep it on the persistent volume mounted at /data.
DB_PATH=./dev.db

PORT=8080

# Comma-separated allowed origins. Mobile apps don't need CORS.
CORS_ORIGINS=*

# Token lifetimes, in Go duration syntax. Access tokens are short-lived and
# renewed automatically. Refresh tokens never expire by default (REFRESH_TTL=0):
# a login lasts until you sign out, which revokes its session on the server.
ACCESS_TTL=15m
REFRESH_TTL=0
